# ------------------------------------------------------------------
# 이 파일은 "템플릿"입니다. 실제 키를 여기에 적지 마세요.
#
# 사용법:
#   1) 이 파일을 복사해서 이름을 .env 로 바꿉니다.
#         cp .env.example .env
#   2) .env 파일을 열어 아래 값에 본인의 실제 키를 채웁니다.
#   3) .env 는 .gitignore 에 등록되어 있어 깃에 올라가지 않습니다.
# ------------------------------------------------------------------

# Materials Project API 키 (https://next-gen.materialsproject.org 에서 발급)
MP_API_KEY=your_materials_project_api_key_here
