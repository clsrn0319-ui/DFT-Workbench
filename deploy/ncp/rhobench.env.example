# RhoBench 서비스 환경변수 — /etc/rhobench.env 로 복사해 값을 채운다 (권한 600)
#
#   sudo cp deploy/ncp/rhobench.env.example /etc/rhobench.env
#   sudo chmod 600 /etc/rhobench.env && sudo nano /etc/rhobench.env
#   sudo systemctl restart rhobench
#
# 비밀번호는 한 번 지정하면 data/access.json 에 해시로 저장된다. 그 뒤에는 이 줄을
# 비워 두어도(주석) 저장된 비밀번호를 그대로 쓴다. 값을 바꾸면 접속자 전원이 로그아웃된다.
RHOBENCH_ACCESS_PASSWORD=여기에_공유_비밀번호

# 내부 포트 — nginx 가 80/443 을 이 포트로 넘긴다. 외부(ACG)에서는 열지 않는다
RHOBENCH_PORT=8000
# 바인드 주소 — nginx 뒤면 127.0.0.1, nginx 없이 8000 을 직접 열면 0.0.0.0
RHOBENCH_HOST=127.0.0.1

# 결과·캠페인·로그 저장 위치 (기본 저장소 안 data/). 별도 디스크를 쓰면 여기를 바꾼다
#RHOBENCH_DATA_DIR=/data/rhobench

# 동시 계산 워커 수 — vCPU 수와 메모리에 맞춘다 (워커 하나가 PySCF 스레드 여럿을 쓴다)
RHOBENCH_WORKERS=1
# 서버 전체 동시 대기·실행 작업 수
RHOBENCH_MAX_ACTIVE_JOBS=4
# 분자 + 명시적 분자 원자 수 상한
RHOBENCH_MAX_ATOMS=60

# 배치 스크리닝
RHOBENCH_BATCH_PARALLEL=1
RHOBENCH_MAX_BATCH=500
RHOBENCH_BATCH_FAIL_RATIO=0.3

# PySCF/OpenMP 스레드 수 — 비워 두면 코어 수 전부. 워커를 2개 이상 두면 코어 수/워커 수로 제한
#OMP_NUM_THREADS=8

# 화학물질 조회에서 Materials Project 도 쓰려면
#MP_API_KEY=
